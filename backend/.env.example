# 이 파일은 "빈 양식"입니다. 실제 값은 같은 폴더의 .env 파일에 적습니다.
# (.env 는 GitHub에 올라가지 않도록 보호되어 있습니다)

# Supabase 프로젝트 주소  (Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase 비밀 열쇠  (Project Settings → API → service_role  ※ 절대 공개 금지)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI 키  (챗봇 단계에서 사용 ※ 절대 공개 금지)
OPENAI_API_KEY=

# ── 아래는 선택 항목 (비워 두면 기본값 사용) ──
# 챗봇 모델 (기본 gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# 질문 횟수 제한: 한 사람당 10분에 10번, 서버 전체 하루 300번
# CHAT_LIMIT_PER_USER=10
# CHAT_LIMIT_WINDOW_SEC=600
# CHAT_LIMIT_PER_DAY=300
# 서버에 접속을 허락할 사이트 주소 (쉼표로 구분, 배포할 때 사용)
# ALLOWED_ORIGINS=https://su4228-prog.github.io
# 호스팅(Render 등)에서만 1 로 설정 — 실제 방문자 주소로 질문 횟수를 셈
# TRUST_PROXY=1
